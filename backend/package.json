{
  "name": "connectlocal-backend",
  "version": "1.0.0",
  "description": "ConnectLocal REST API - Location-based service marketplace",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --fix",
    "migrate": "node migrations/run.js"
  },
  "keywords": [
    "service-marketplace",
    "express",
    "supabase",
    "location-based"
  ],
  "author": "ConnectLocal Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "@supabase/supabase-js": "^2.38.0",
    "jsonwebtoken": "^9.1.2",
    "pino": "^8.16.2",
    "pino-http": "^8.4.1",
    "zod": "^3.22.4",
    "express-validator": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "node-geocoder": "^4.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "eslint": "^8.52.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
