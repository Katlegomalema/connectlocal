# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# External APIs
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_API_KEY=your-payfast-api-key
PAYFAST_PASSPHRASE=your-payfast-passphrase

# Firebase/Push Notifications
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Application Settings
SEARCH_RADIUS_KM=50
MAX_BOOKING_ADVANCE_DAYS=365
CANCELLATION_POLICY_HOURS=24

# Cors Settings
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Extra allowed browser origins, comma-separated, exact match (e.g. the Netlify sites)
CORS_ORIGINS=https://your-site.netlify.app

# Supabase root CA (Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate)
DB_SSL_CA=certs/supabase-ca.crt

# HMAC key for arrival PIN / phone OTP hashes (generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))")
CODE_HASH_SECRET=
# Outside production, return the phone OTP in the API response (no paid SMS). Never true in production.
PHONE_OTP_DEV_ECHO=true
