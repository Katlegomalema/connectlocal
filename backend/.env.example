# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# External APIs
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_API_KEY=your-payfast-api-key
PAYFAST_PASSPHRASE=your-payfast-passphrase

# Firebase/Push Notifications
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Application Settings
SEARCH_RADIUS_KM=50
MAX_BOOKING_ADVANCE_DAYS=365
CANCELLATION_POLICY_HOURS=24

# Cors Settings
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Extra allowed browser origins, comma-separated, exact match (e.g. the Netlify sites)
CORS_ORIGINS=https://your-site.netlify.app

# Supabase root CA (Dashboard -> Project Settings -> Database -> SSL Configuration -> Download certificate)
DB_SSL_CA=certs/supabase-ca.crt

# HMAC key for arrival PIN / phone OTP hashes (generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))")
CODE_HASH_SECRET=
# Outside production, return the phone OTP in the API response (no paid SMS). Never true in production.
PHONE_OTP_DEV_ECHO=true
# Outside production: create new accounts already email-confirmed (no confirmation email is sent).
# Needed when Supabase has no SMTP set up: its built-in email only sends to project team members, so every
# other sign-up fails. Never true in production.
AUTH_AUTO_CONFIRM_SIGNUPS=false

# Where the password-reset email link opens: the customer app's web address (also add it in Supabase ->
# Authentication -> URL Configuration -> Redirect URLs). See SETUP.md, "Password reset email".
PASSWORD_RESET_REDIRECT_URL=https://your-app.netlify.app/
# Public HTTPS address of this API (PayFast ITN target)
PUBLIC_API_URL=https://your-api.example.com
# sandbox (default) or live
PAYFAST_MODE=sandbox
# How many X-Forwarded-For entries (from the right) our own proxy adds; used for PayFast's IP check.
# Codespaces port forwarding: 1. If ITNs are rejected "from a non-PayFast address", the log shows the chain.
PAYFAST_TRUSTED_PROXY_HOPS=1

# AES-256-GCM key for bank account numbers (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PAYOUT_ENCRYPTION_KEY=
# Automatic payouts: "simulated" marks payouts paid with a SIM- reference (ONLY works with PAYFAST_MODE=sandbox;
# ignored when live); "off" leaves them pending. Leave empty for the default (simulated in sandbox, off when live).
PAYOUT_MODE=
PAYOUT_INTERVAL_SECONDS=60

# Address search (GET /api/v1/geo/*) goes through this server to OpenStreetMap Nominatim (max 1 request/second,
# cached). Nominatim refuses apps that don't identify themselves; an email lets them contact us instead of blocking.
NOMINATIM_USER_AGENT=ConnectLocal/1.0 (student marketplace project; +https://github.com/Katlegomalema/connectlocal)
NOMINATIM_EMAIL=
